# ===== 通用（全项目一致）=====
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ===== 各 agent 自带的数据目录（工具私有产物，不是项目资产）=====
# 换 agent / 换会话时上下文靠 .memory\ 续（规范 2.2），不靠这些目录
.workbuddy/
.claude/
.cursor/
.codex/
.agents/
.grok/

# ===== 本机私有区：永不入库（本机绝对路径配置 / 凭据副本 / 抓包测试数据）=====
.local/

# 公开仓：.memory\ 含本机路径 / 内部项目名 / 研发记录，不入库
.memory/

# ===== 日志 =====
*.log
logs/

# ===== 环境变量 =====
.env
.env.local
.env.*.local

# ===== 通用构建产物 =====
dist/
build/
out/

# ===== 测试覆盖 =====
coverage/
htmlcov/
lcov.info

# ===== 数据库文件 =====
*.db
*.sqlite
*.sqlite3

# ===== 编译二进制（go / csharp / rust 产出；其余语言不受影响）=====
*.exe
*.dll
*.so
*.dylib
*.test
*.exe.bak-*
vendor/

# ===== 语言专属（new-project.ps1 按 -Lang 注入）=====
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
*.egg-info/
.eggs/
.coverage
